# ============================================================
# LEAF SEGMENTATION
# ============================================================

def segment_leaf(img):

    img_np = np.array(img)

    hsv = cv2.cvtColor(
        img_np,
        cv2.COLOR_RGB2HSV
    )

    lower = np.array([
        25, 40, 40
    ])

    upper = np.array([
        95, 255, 255
    ])

    mask = cv2.inRange(
        hsv,
        lower,
        upper
    )

    kernel = np.ones(
        (5, 5),
        np.uint8
    )

    mask = cv2.morphologyEx(
        mask,
        cv2.MORPH_CLOSE,
        kernel
    )

    if np.count_nonzero(mask) == 0:

        return Image.fromarray(
            img_np
        )

    result = cv2.bitwise_and(
        img_np,
        img_np,
        mask=mask
    )

    ys, xs = np.where(
        mask > 0
    )

    x_min, x_max = xs.min(), xs.max()
    y_min, y_max = ys.min(), ys.max()

    cropped = result[
        y_min:y_max + 1,
        x_min:x_max + 1
    ]

    resized = cv2.resize(
        cropped,
        (
            img_np.shape[1],
            img_np.shape[0]
        )
    )

    return Image.fromarray(
        resized
    )

