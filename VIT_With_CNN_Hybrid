# ============================================================
# VISION TRANSFORMER
# ============================================================

class ViTBlock(nn.Module):

    def __init__(
        self,
        input_dim,
        num_patches,
        embed_dim=64,
        num_heads=8,
        mlp_dim=256,
        dropout=0.01
    ):

        super().__init__()


        # Linear patch embedding
        self.embedding = nn.Linear(
            input_dim,
            embed_dim
        )


        # Learnable positional embedding
        self.pos_embedding = nn.Parameter(
            torch.zeros(
                1,
                num_patches,
                embed_dim
            )
        )


        # Transformer encoder
        encoder_layer = (
            nn.TransformerEncoderLayer(
                d_model=embed_dim,
                nhead=num_heads,
                dim_feedforward=mlp_dim,
                dropout=dropout,
                activation="gelu",
                batch_first=True,
                norm_first=True
            )
        )


        self.transformer = (
            nn.TransformerEncoder(
                encoder_layer,
                num_layers=1
            )
        )


        self.dropout = nn.Dropout(
            dropout
        )


    def forward(self, x):

        # x:
        # [B, 16, 17920]

        x = self.embedding(x)

        # [B, 16, 64]

        x = x + self.pos_embedding

        x = self.dropout(x)

        x = self.transformer(x)

        return x

# ============================================================
# HYBRID CNN + VIT
# ============================================================

class HybridCNNViT(nn.Module):

    def __init__(
        self,
        num_classes=4
    ):

        super().__init__()


        # ----------------------------------------------------
        # CNNs
        # ----------------------------------------------------

        vgg_model = models.vgg16(
            weights=VGG16_Weights.DEFAULT
        )

        inception_model = models.inception_v3(
            weights=Inception_V3_Weights.DEFAULT,
            aux_logits=True
        )

        densenet_model = models.densenet201(
            weights=DenseNet201_Weights.DEFAULT
        )


        self.vgg = VGGFeatureExtractor(
            vgg_model
        )

        self.inception = InceptionFeatureExtractor(
            inception_model
        )

        self.densenet = DenseNetFeatureExtractor(
            densenet_model
        )


        # ----------------------------------------------------
        # Feature dimensions
        # ----------------------------------------------------

        # VGG:       512 channels
        # Inception: 2048 channels
        # DenseNet:  1920 channels

        total_channels = (
            512
            +
            2048
            +
            1920
        )

        # = 4480


        # ----------------------------------------------------
        # ViT
        # ----------------------------------------------------

        patch_size = 2

        num_patches = (
            4 // patch_size
        ) ** 2

        # = 4 patches if using 4x4 feature map

        # Each patch:
        #
        # 2 x 2 x 4480
        #
        # = 17920 features

        patch_dim = (
            patch_size
            *
            patch_size
            *
            total_channels
        )


        self.vit = ViTBlock(
            input_dim=patch_dim,
            num_patches=num_patches,
            embed_dim=64,
            num_heads=8,
            mlp_dim=256,
            dropout=0.01
        )


        # ----------------------------------------------------
        # Classification head
        # ----------------------------------------------------

        self.classifier = nn.Sequential(

            nn.Flatten(),

            nn.Linear(
                num_patches * 64,
                256
            ),

            nn.ReLU(),

            nn.Dropout(
                0.01
            ),

            nn.Linear(
                256,
                num_classes
            )
        )


    def forward(self, x):

        # ----------------------------------------------------
        # CNN feature extraction
        # ----------------------------------------------------

        vgg_features = self.vgg(x)

        inception_features = self.inception(x)

        densenet_features = self.densenet(x)


        # ----------------------------------------------------
        # Standardize spatial dimensions
        # ----------------------------------------------------

        # VGG and DenseNet:
        # 4 x 4
        #
        # Inception:
        # 2 x 2


        # Zero-pad Inception to 4 x 4
        inception_features = nn.functional.pad(
            inception_features,
            (1, 1, 1, 1)
        )


        # ----------------------------------------------------
        # Feature concatenation
        # ----------------------------------------------------

        combined = torch.cat(
            [
                vgg_features,
                inception_features,
                densenet_features
            ],
            dim=1
        )


        # Shape:
        #
        # [B, 4480, 4, 4]


        # ----------------------------------------------------
        # Convert to patches
        # ----------------------------------------------------

        B, C, H, W = combined.shape

        patch_size = 2


        # [B, C, 2, 2, 2, 2]

        patches = combined.unfold(
            2,
            patch_size,
            patch_size
        ).unfold(
            3,
            patch_size,
            patch_size
        )


        # [B, C, 2, 2, 2, 2]


        # Rearrange:
        #
        # B
        # patches
        # patch pixels
        # channels

        patches = patches.permute(
            0,
            2,
            3,
            4,
            5,
            1
        )


        # Flatten each patch

        patches = patches.reshape(
            B,
            -1,
            patch_size
            *
            patch_size
            *
            C
        )


        # [B, 4, 17920]


        # ----------------------------------------------------
        # ViT
        # ----------------------------------------------------

        vit_output = self.vit(
            patches
        )


        # ----------------------------------------------------
        # Classification
        # ----------------------------------------------------

        output = self.classifier(
            vit_output
        )


        return output

